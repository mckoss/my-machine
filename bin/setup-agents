#!/bin/bash
# Share one global AGENTS.md across AI coding harnesses (and machines).
#
#   ~/.agents/AGENTS.md  -> <repo>/home/.agents/AGENTS.md
#   ~/.claude/CLAUDE.md  -> <repo>/home/.agents/AGENTS.md
#   ~/.codex/AGENTS.md   -> <repo>/home/.agents/AGENTS.md
#   ~/.gemini/GEMINI.md  -> <repo>/home/.agents/AGENTS.md
#
# Safe to re-run. Never deletes a file: a plain file is moved aside to a
# .bak-* backup before linking, and one that differs from the repo copy is
# only replaced if you agree.
# Usage: setup-agents [-y]   (-y answers yes to backup-and-link prompts)
BIN_DIR="$(cd $(dirname ${BASH_SOURCE[0]}) && pwd)"
source $BIN_DIR/.envrc
source $BIN_DIR/setup-funcs.sh

if [[ "$1" == "-y" ]]; then
    ASKYES=true; shift
else
    ASKYES=${ASKYES:-false}
fi

REPO_FILE="$PROJ_DIR/home/.agents/AGENTS.md"

if [ ! -f "$REPO_FILE" ]; then
    echo "Missing $REPO_FILE." >&2
    exit 1
fi

# link_agents <path> - make <path> a symlink to the repo copy, backing up any
# plain file there and asking first if its content differs.
link_agents () {
    local dest="$1"

    if [ -L "$dest" ] && [ "$(readlink "$dest")" == "$REPO_FILE" ]; then
        echo "$dest already linked."
        return
    fi

    if [ -L "$dest" ] && [ ! -e "$dest" ]; then
        echo "Replacing dangling link $dest -> $(readlink "$dest")."
    elif [ -L "$dest" ] && cmp -s "$dest" "$REPO_FILE"; then
        echo "Replacing indirect link $dest -> $(readlink "$dest")."
    elif [ -e "$dest" ] || [ -L "$dest" ]; then
        if ! cmp -s "$dest" "$REPO_FILE"; then
            echo "$dest differs from $REPO_FILE:"
            diff -u "$REPO_FILE" "$dest" | head -40
            if ! ask "Move $dest to a .bak file and link it"; then
                echo "Skipped $dest - merge it into $REPO_FILE and re-run."
                return
            fi
        fi
        local backup="$dest.bak-$(date +%Y%m%d-%H%M%S)"
        mv "$dest" "$backup"
        echo "Backed up $dest to $backup."
    fi

    mkdir -p "$(dirname "$dest")"
    ln -sfn "$REPO_FILE" "$dest"
    echo "Linked $dest -> $REPO_FILE."
}

link_agents "$HOME/.agents/AGENTS.md"
link_agents "$HOME/.claude/CLAUDE.md"
link_agents "$HOME/.codex/AGENTS.md"
link_agents "$HOME/.gemini/GEMINI.md"
