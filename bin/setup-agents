#!/bin/bash
# Share one global AGENTS.md across AI coding harnesses (and machines).
#
#   ~/.claude/CLAUDE.md  -> <repo>/home/.agents/AGENTS.md
#   ~/.codex/AGENTS.md   -> <repo>/home/.agents/AGENTS.md
#   ~/.gemini/GEMINI.md  -> <repo>/home/.agents/AGENTS.md
#
# Safe to re-run. Never overwrites a file whose content differs from the repo
# copy; it asks first, and then only moves the file aside to a .bak-* backup.
# Usage: setup-agents [-y]   (-y answers yes to backup-and-link prompts)
BIN_DIR="$(cd $(dirname ${BASH_SOURCE[0]}) && pwd)"
source $BIN_DIR/.envrc
source $BIN_DIR/setup-funcs.sh

if [[ "$1" == "-y" ]]; then
    ASKYES=true; shift
else
    ASKYES=${ASKYES:-false}
fi

REPO_FILE="$PROJ_DIR/home/.agents/AGENTS.md"

if [ ! -f "$REPO_FILE" ]; then
    echo "Missing $REPO_FILE." >&2
    exit 1
fi

# link_agents <link path> <link target> - make <link path> a symlink to
# <link target> without losing any content that differs from the repo copy.
link_agents () {
    local dest="$1" target="$2"
    local dir="$(dirname "$dest")"

    if [ -L "$dest" ] && [ "$(readlink "$dest")" == "$target" ]; then
        echo "$dest already linked."
        return
    fi

    if [ -L "$dest" ] && [ ! -e "$dest" ]; then
        echo "Replacing dangling link $dest -> $(readlink "$dest")."
    elif [ -e "$dest" ] && cmp -s "$dest" "$REPO_FILE"; then
        echo "$dest matches the repo copy; replacing it with a link."
    elif [ -e "$dest" ] || [ -L "$dest" ]; then
        echo "$dest differs from $REPO_FILE:"
        diff -u "$REPO_FILE" "$dest" | head -40
        if ! ask "Move $dest to a .bak file and link it"; then
            echo "Skipped $dest - merge it into $REPO_FILE and re-run."
            return
        fi
        local backup="$dest.bak-$(date +%Y%m%d-%H%M%S)"
        mv "$dest" "$backup"
        echo "Backed up to $backup."
    fi

    mkdir -p "$dir"
    ln -sfn "$target" "$dest"
    echo "Linked $dest -> $target."
}

link_agents "$HOME/.claude/CLAUDE.md" "$REPO_FILE"
link_agents "$HOME/.codex/AGENTS.md" "$REPO_FILE"
link_agents "$HOME/.gemini/GEMINI.md" "$REPO_FILE"
